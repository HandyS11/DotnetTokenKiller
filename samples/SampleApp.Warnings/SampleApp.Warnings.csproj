<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Override the global TreatWarningsAsErrors so this project compiles with warnings only -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Suppress analyzer noise that is not relevant to the demo -->
    <NoWarn>$(NoWarn);CA1515;CS1591;CA1303;CA1822;CA1062;CA1861;CA2241;CA1050;S3626;RCS1163;S1186;RCS1135;CA1041;S1172;RCS1175</NoWarn>
  </PropertyGroup>
</Project>
