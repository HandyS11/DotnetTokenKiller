#!/bin/sh
# Pre-commit hook: run dotnet format on staged .cs files and check .csproj formatting
# Install: git config core.hooksPath .githooks

STAGED_CS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')
STAGED_PROJ_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.csproj' '*.props' '*.targets')

# Format C# files
if [ -n "$STAGED_CS_FILES" ]; then
  # Build comma-separated include list for dotnet format
  INCLUDE_LIST=$(echo "$STAGED_CS_FILES" | paste -sd ',' -)

  echo "Running dotnet format on staged C# files..."
  dotnet format ProjGraph.slnx --no-restore --include "$INCLUDE_LIST"

  # Re-stage any files that dotnet format modified
  echo "$STAGED_CS_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
      git add "$file"
    fi
  done

  # Verify formatting is clean
  dotnet format ProjGraph.slnx --no-restore --verify-no-changes --include "$INCLUDE_LIST"
  if [ $? -ne 0 ]; then
    echo "Error: dotnet format could not fully resolve formatting issues."
    echo "Please fix manually and try again."
    exit 1
  fi
fi

# Check XML project files for trailing whitespace, BOM, and CRLF line endings
if [ -n "$STAGED_PROJ_FILES" ]; then
  FAIL=0
  for file in $STAGED_PROJ_FILES; do
    if [ ! -f "$file" ]; then
      continue
    fi

    # Check for CRLF line endings
    if grep -Pql '\r$' "$file" 2>/dev/null; then
      echo "Error: $file has CRLF line endings. Convert to LF."
      FAIL=1
    fi

    # Check for trailing whitespace
    if grep -Pqn '[ \t]+$' "$file" 2>/dev/null; then
      echo "Error: $file has trailing whitespace."
      FAIL=1
    fi

    # Check for BOM
    if head -c 3 "$file" | grep -qP '\xef\xbb\xbf' 2>/dev/null; then
      echo "Error: $file has a UTF-8 BOM. Remove it."
      FAIL=1
    fi
  done

  if [ $FAIL -ne 0 ]; then
    echo "Fix the above project file issues and try again."
    exit 1
  fi
fi

exit 0
